# Minimal OpenSSL config used to (re)generate the self-signed relay test
# certificate. TEST-ONLY key material: never reuse it for a real relay.
# Run from the plugin root:
#   openssl req -x509 -newkey rsa:2048 -nodes -config test/fixtures/tls/openssl.cnf \
#     -keyout test/fixtures/tls/relay-key.pem -out test/fixtures/tls/relay-cert.pem \
#     -days 3650 -subj "/CN=localhost"
[req]
distinguished_name = dn
x509_extensions = v3_ca
prompt = no

[dn]
CN = localhost

[v3_ca]
subjectAltName = @alt_names
basicConstraints = critical, CA:TRUE
keyUsage = critical, digitalSignature, keyEncipherment, keyCertSign

[alt_names]
DNS.1 = localhost
IP.1 = 127.0.0.1
