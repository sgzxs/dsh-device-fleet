{
  "name": "dsh-device-fleet",
  "version": "1.20.8",
  "description": "DeepSeek Harness device fleet: enroll devices, direct-call remote tools, shared Rooms with lazy-woken agents, and delegated subagents across devices.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgzxs/dsh-device-fleet.git"
  },
  "homepage": "https://github.com/sgzxs/dsh-device-fleet#readme",
  "bugs": {
    "url": "https://github.com/sgzxs/dsh-device-fleet/issues"
  },
  "type": "module",
  "main": "src/plugin/index.js",
  "exports": {
    ".": "./src/plugin/index.js",
    "./client": "./client.js",
    "./net": "./src/net/index.js",
    "./host": "./src/host/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node test/net.test.mjs && node test/host.test.mjs && node test/overlay.test.mjs && node test/perf.test.mjs",
    "test:net": "node test/net.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:overlay": "node test/overlay.test.mjs",
    "test:perf": "node test/perf.test.mjs",
    "ci": "node scripts/ci.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "files": [
    "src",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "CONTEXT.md",
    "docs",
    "scripts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "dev"
  },
  "license": "MIT"
}